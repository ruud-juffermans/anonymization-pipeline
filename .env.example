# Copy to .env and adjust. NEVER commit your real .env (it is gitignored).

# --- Local LLM (Ollama) -----------------------------------------------------
# In docker compose this is overridden to http://ollama:11434 automatically.
# For a NATIVE Ollama on macOS (GPU acceleration), see README and use:
#   OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# NER backend: ollama | spacy | none
NER_BACKEND=ollama

# --- Vault ------------------------------------------------------------------
# Passphrase for encrypting/decrypting case vaults. The CLI reads this so you
# are not prompted interactively. Leave UNSET to be prompted instead (safer).
# ANON_PASSPHRASE=change-me
